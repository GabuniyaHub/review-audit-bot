NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://review_audit:change_me@127.0.0.1:5432/review_audit
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=10000
# PostgreSQL TLS is configured explicitly; use a trusted server certificate.
DB_SSL=false
# Enable only after setting a private bot token. One poller per bot.
TELEGRAM_ENABLED=false
# Optional when the corresponding workers are disabled:
TELEGRAM_BOT_TOKEN=
LLM_API_KEY=

# Collection is opt-in. Confirm source cards in the bot before /collect.
COLLECTION_ENABLED=false
COLLECTION_MAX_REVIEWS=150
COLLECTION_TIMEOUT_MS=15000
COLLECTION_PAGE_DELAY_MS=1000
TWOGIS_REVIEWS_KEY=

# api: разрешённый ключ; browser: публичная страница, нужен Chromium
TWOGIS_MODE=browser

# OpenRouter, opt-in. OPENROUTER_API_KEY also accepted (takes precedence).
ANALYSIS_ENABLED=false
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_TIMEOUT_MS=90000
ANALYSIS_BATCH_SIZE=5
