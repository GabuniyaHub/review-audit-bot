{
  "name": "review-audit-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Учебный сервис сравнительного репутационного аудита",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "start:prod": "node dist/src/main.js",
    "start:dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "npm run build && node dist/src/database/migrate.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:integration": "npm run build && node --test dist/test/integration/*.test.js",
    "db:migrate:prod": "node dist/src/database/migrate.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "cheerio": "^1.2.0",
    "dotenv": "^17.0.0",
    "pg": "^8.16.0",
    "playwright": "^1.64.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  },
  "type": "module"
}
